# Local OpenAI-compatible llama-server
LOCAL_LLM_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=local-model
# llama-server normally ignores the key; "local" is used by the OpenAI-compatible client.
LOCAL_LLM_API_KEY=local

# Local project memory
JARVIS_PROJECT_MEMORY_DIR=data/project_memory
JARVIS_REQUIRE_AUTH=true

# LiveKit
# Get these from your LiveKit Cloud project or your self-hosted server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=jarvis

# LiveKit voice models.
# These use LiveKit Inference when the selected model is available there.
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=en
LIVEKIT_TTS_MODEL=inworld/inworld-tts-2
LIVEKIT_TTS_VOICE=Ashley

# Optional local Piper fallback (legacy voice loop)
# PIPER_EXE=C:/path/to/piper.exe
# PIPER_MODEL=C:/path/to/voice.onnx
